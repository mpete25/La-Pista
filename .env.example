# La Pista — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit the filled-in file. Only `.env.example` belongs in git.

# --- Supabase (frontend-safe) ---
# The anon key is publishable and protected by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server-side only — Edge Functions, NEVER expose in frontend) ---
# Bypasses RLS. Must never be prefixed with VITE_ or shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMS gateway (server-side only, used from a Supabase Edge Function) ---
# Danish gateway: GatewayAPI or inMobile. Keys must never live in the frontend.
# Set these with `npx supabase secrets set`, not in the frontend .env.local.
SMS_PROVIDER=gatewayapi
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=La Pista

# Safety catch: with no API key the send-sms function never sends, it only
# reports what is queued. Set this to true to keep that behaviour even after
# the key is configured — useful while testing against real data.
SMS_DRY_RUN=false

# Shared secret the scheduler passes as `x-cron-secret` when it calls
# send-sms. Any long random string; rotate it like a password.
CRON_SECRET=
